        "name": "changes",
        "jsonName": "changes",
        "kind": "list",
        "message": "DocumentChange",
        "optional": false,
        "rules": {}
      }
    ],
    "oneofs": [],
    "rules": {
      "cel": [
        {
          "id": "feedback.failure_reason",
          "message": "parked, failed, and uncertain receipts require a reason",
          "expression": "!(this.state in [4, 6, 7]) || size(this.reason) > 0"
        },
        {
          "id": "feedback.answer_evidence",
          "message": "answered receipts require a summary and real response ID",
          "expression": "this.state != 5 || (size(this.summary) > 0 && size(this.response_id) > 0)"
        }
      ]
    }
  },
