{
  "version": 1,
  "rollout": "strict",
  "projects": [
    "tsconfig.json"
  ],
  "exclude": [
    {
      "path": "src/generated",
      "reason": "Authoritative Protobuf-ES output is checked by pinned regeneration, Buf contract checks and the strict compiler."
    }
  ],
  "commands": {
    "legacy": [
      [
        "bun",
        "run",
        "check:generated"
      ]
    ],
    "test": [
      "bun",
      "run",
      "test"
    ],
    "audit": [
      "bun",
      "audit"
    ]
  }
}
