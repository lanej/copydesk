#!/usr/bin/env bash
set -euo pipefail

# CI owns this disposable prefix; the workstation installation is never replaced.
prefix=${1:?Usage: install-test-neovim PREFIX}
mkdir -p "$prefix/bin"
if [ -x "$prefix/bin/nvim" ] && "$prefix/bin/nvim" --version | head -n 1 | grep -Fxq 'NVIM v0.12.6'; then
  exit 0
fi
case "$(uname -s)/$(uname -m)" in
  Linux/x86_64) asset=nvim-linux-x86_64; digest=474430d53e6264f6d6dd18db42d6dc9df3a1b56ca9e88a325bbf860e1a811d87 ;;
  Linux/aarch64) asset=nvim-linux-arm64; digest=8f1f64a0bdb97247034038c3823c6cbad5bdf9ecd5751b85494b71c3ee04c815 ;;
  Darwin/arm64) asset=nvim-macos-arm64; digest=1dbd148222b051ba6c307c4d17a318ed083df018a4f6a5a0ce46955ffc9ab87b ;;
  Darwin/x86_64) asset=nvim-macos-x86_64; digest=481424f1dbc85f637d57e47d27d042aa9c883e5a4fe9ee64fc4ee9573b221998 ;;
  *) printf 'Unsupported Neovim fixture host\n' >&2; exit 1 ;;
esac
curl --fail --location --retry 3 "https://github.com/neovim/neovim/releases/download/v0.12.6/$asset.tar.gz" -o "$prefix/nvim.tar.gz"
printf '%s  %s\n' "$digest" "$prefix/nvim.tar.gz" | shasum -a 256 --check -
tar -xzf "$prefix/nvim.tar.gz" -C "$prefix"
ln -sf "../$asset/bin/nvim" "$prefix/bin/nvim"
rm "$prefix/nvim.tar.gz"
